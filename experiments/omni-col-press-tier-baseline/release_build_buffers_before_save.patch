diff --git a/src/build_index.py b/src/build_index.py
--- a/src/build_index.py
+++ b/src/build_index.py
@@ -1,5 +1,6 @@
 #!/usr/bin/env python3
 
+import gc
 import os
 import sys
 import logging
@@ -340,6 +341,13 @@ def main():
     logger.info(f"Building type:{index_args.index_type} index ...")
     build_config = _get_build_config(model_args, data_args, index_args, len(doc_ids), embeddings.shape)
     index = build_index(index_args.index_type, embeddings, masks, doc_ids, metadata, device, build_config, index_args.index_output_path)
+
+    # build_index has materialized its own tensor storage. Release the merged
+    # NumPy corpus buffers before torch.save stages a CUDA index through host
+    # memory. Keeping both copies alive makes large Full indexes exceed the
+    # host-memory limit during serialization even though encoding completed.
+    del embeddings, masks
+    gc.collect()
     
     _save(index_args.index_output_path, index, failures, index_args.output_pickle, build_config)
     
